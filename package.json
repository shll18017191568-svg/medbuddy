{
  "name": "medbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "MedBuddy 医生智能工作台 - 一人公司 x AI 开发",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "worker": "npm run worker --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run typecheck --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "db:push": "npm exec --workspace apps/web prisma db push",
    "db:studio": "npm exec --workspace apps/web prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
