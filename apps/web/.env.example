# Web 服务环境变量（复制为 .env 并按需修改）
# 数据库：本地开发 SQLite；上线切 Supabase Postgres 连接串（详见 docs/DEPLOYMENT.md）
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/medbuddy?schema=public"
# 会话签名密钥（生产必须 >=16 字符随机值）
AUTH_SECRET="dev-only-secret-key-change-in-prod"
# 短信服务商：dev=验证码直接返回页面（联调）；aliyun=阿里云 SMS 真实下发
# 生产必须配置 aliyun 并填齐下方 ALIYUN_SMS_*；未配置会明确报错（不会静默收不到码）
SMS_PROVIDER="dev"
# 阿里云 SMS（AccessKey 建议用仅授权 dysmsapi 的 RAM 子账号）
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
# 模板内容需含 ${code} 变量，如：您的验证码为 ${code}，5 分钟内有效
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_REGION="cn-hangzhou"
# AI 服务地址
AI_SERVICE_URL=http://localhost:8000
# 任务队列：inline=单实例进程内执行；bullmq=Redis 持久化队列（多实例必须）
TASK_QUEUE_DRIVER="inline"
REDIS_URL="redis://127.0.0.1:6379/0"
TASK_WORKER_CONCURRENCY="2"
# 运营后台管理员手机号白名单（逗号分隔，登录时自动提权）
ADMIN_PHONES=""

# ---- 支付通道（未配置时自动回退模拟支付，不产生真实扣款）----
# 默认渠道：mock | wechat | alipay
PAYMENT_PROVIDER="mock"
# 回调域名（微信/支付宝需要公网可达；本地联调可留空）
PUBLIC_BASE_URL="http://localhost:3000"
# 微信支付 v3（Native 扫码）
WECHAT_PAY_APPID=""
WECHAT_PAY_MCHID=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PLATFORM_CERT=""
WECHAT_PAY_NOTIFY_URL=""
# 支付宝（电脑网站支付，RSA2）
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
