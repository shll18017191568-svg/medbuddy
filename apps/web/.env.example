# Web 服务环境变量（复制为 .env 并按需修改）
# 数据库：本地开发 SQLite；上线切 Supabase Postgres 连接串
DATABASE_URL="file:./dev.db"
# 会话签名密钥（生产必须 >=16 字符随机值）
AUTH_SECRET="dev-only-secret-key-change-in-prod"
# 短信服务商：dev=验证码直接返回页面（联调）；生产接 aliyun/tencent
SMS_PROVIDER="dev"
# AI 服务地址
AI_SERVICE_URL=http://localhost:8000
# 运营后台管理员手机号白名单（逗号分隔，登录时自动提权）
ADMIN_PHONES=""
