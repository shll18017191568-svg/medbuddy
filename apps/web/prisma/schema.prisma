// MedBuddy 数据模型（S1：用户认证 + 积分账户）
// 注意：本地开发用 SQLite；上线时将 provider 改为 "postgresql" 并切换 DATABASE_URL 即可（模型兼容）。
// SQLite 不支持 enum，状态字段用 String + 代码层常量约束（见 packages/shared）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户（医生 / 管理员）
model User {
  id        String   @id @default(cuid())
  phone     String   @unique // 登录唯一凭证
  role      String   @default("DOCTOR") // DOCTOR | ADMIN
  status    String   @default("ACTIVE") // ACTIVE | DISABLED
  memberLevel    String    @default("free") // free | pro | flagship
  memberExpireAt DateTime? // 为空或已过期按免费版处理
  inviteCode     String?   @unique // 我的邀请码（首次进入邀请页时生成）
  invitedById    String? // 邀请人用户 ID（注册时绑定，终身一次）
  invitedAt      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile DoctorProfile?
  credits CreditAccount?
  tasks   Task[]
  ledgers CreditLedger[]
  checkIns CheckIn[]
  rechargeOrders RechargeOrder[]
  membershipOrders MembershipOrder[]
  avatarJobs AvatarJob[]

  @@index([invitedById])
}

/// 数字人任务单（一期第三方 API 异步合成，凭供应商单号追踪进度）
model AvatarJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String? // 关联任务单
  kind        String // CLONE | VIDEO
  provider    String // zhiying | silicon | mock
  vendorJobId String? // 供应商返回的任务单号
  status      String   @default("SUBMITTED") // SUBMITTED | PROCESSING | COMPLETED | FAILED
  paramsJson  String // 提交参数（播报稿/克隆类型等）
  resultJson  String? // 供应商返回/交付物
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([taskId])
}

/// 积分充值订单：CREATED → PENDING → PAID / FAILED / REFUNDED
/// 金额一律存「分」；回调验签 + outTradeNo/transactionId 去重保证幂等
model RechargeOrder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  packageId     String
  priceYuan     Int
  credits       Int
  provider      String    @default("mock") // mock | wechat | alipay
  outTradeNo    String    @unique @default(cuid()) // 商户订单号（提交给支付平台）
  transactionId String?   @unique // 支付平台交易号（回调幂等依据）
  amountFen     Int       @default(0) // 应付金额（分）
  status        String    @default("CREATED") // CREATED | PENDING | PAID | FAILED | REFUNDED
  paidAt        DateTime?
  callbackJson  String? // 回调原文（对账与审计）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt])
}

/// 会员开通/续费订单：支付回调成功后才开通，金额单位分
model MembershipOrder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  level         String // pro | flagship
  periodDays    Int       @default(30)
  provider      String    @default("mock") // mock | wechat | alipay
  outTradeNo    String    @unique @default(cuid()) // MM 前缀，与充值单区分
  transactionId String?   @unique // 回调幂等依据
  amountFen     Int
  status        String    @default("CREATED") // CREATED | PENDING | PAID | FAILED | REFUNDED
  paidAt        DateTime?
  callbackJson  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt])
}

/// 医生认证资料（S1 仅采集，人工审核在运营后台补齐）
model DoctorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String // 真实姓名
  hospital     String // 所在医院
  department   String // 科室
  title        String // 职称：住院医师/主治/副主任/主任医师
  certNo       String? // 执业证书编号（选填）
  verifyStatus String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 短信验证码（开发模式码值直接返回；生产接短信服务商后只入库不返回）
model SmsCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  purpose   String    @default("LOGIN") // LOGIN
  attempts  Int       @default(0) // 连续校验失败次数，达上限即锁定，防暴力枚举
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// 积分账户（S1 建表 + 注册赠送；签到/消费在后续任务卡）
model CreditAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // 当前积分余额
  totalEarn Int      @default(0) // 累计获得（防对账错误）
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 任务单：提交 → 排队 → 执行 → 审核 → 回传提交医生（总纲 §1.4 业务闭环）
model Task {
  id          String    @id @default(cuid())
  userId      String
  type        String // TaskType（packages/shared）
  mode        String    @default("CRAFT") // TaskMode：CRAFT/PLAN/ASK
  title       String
  model       String    @default("auto") // 任务级模型选择：auto/deepseek/qwen/glm（未配置或失败自动回退默认）
  inputJson   String // 任务输入参数（JSON 字符串，SQLite 无原生 JSON）
  status      String    @default("queued") // TaskStatus 状态机（值与 packages/shared 枚举一致，全小写）
  creditCost  Int       @default(0) // 本单扣减积分
  resultJson  String? // 交付物（JSON 字符串）
  failReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  deliveredAt DateTime?
  // 合规审核台字段（进入 REVIEWING 前为 null）
  reviewStatus String? // PENDING | APPROVED | REJECTED（packages/shared ReviewStatus）
  reviewNote   String? // 审核意见（驳回必填，同步给提交医生）
  reviewedAt   DateTime?
  reviewerId   String? // 审核管理员
  reviewerName String?
  // AI 合规预审结果（人工审核前自动生成，供审核员参考）
  precheckStatus String? // PASS | WARN | HIGH_RISK
  precheckJson   String? // 预审发现项明细（JSON）
  precheckAt     DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TaskMessage[]

  @@index([reviewStatus])

  @@index([userId, createdAt])
  @@index([status])
}

/// 任务追问会话：仅交付后的定向回传任务可对话，按时间顺序留存
model TaskMessage {
  id        String   @id @default(cuid())
  taskId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// 积分流水：所有余额变动必须留痕（对账依据）
model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  taskId       String? // 关联任务（注册/赠送类为空）
  type         String // REGISTER | CONSUME | REFUND | BONUS
  amount       Int // 正=收入，负=支出
  balanceAfter Int // 变动后余额（快速对账）
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 每日签到记录（userId+date 唯一约束，数据库层防重复签到）
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD（Asia/Shanghai 自然日）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
