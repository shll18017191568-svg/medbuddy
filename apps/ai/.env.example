# 复制为 .env 并填入真实 Key（.env 已被 gitignore）
# 生产环境改为 prod，并配置正式域名的 CORS 白名单
ENV=dev
# 允许跨域的来源（JSON 数组）；浏览器不直连 AI 服务时可只填正式域名
CORS_ORIGINS=["http://localhost:3000"]

# 大模型路由：auto 按已配置 Key 自动选择；也可显式指定 deepseek/qwen/glm/mock
LLM_PROVIDER=auto
# 覆盖默认模型（留空用服务商默认：deepseek-chat / qwen-plus / glm-4-flash）
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 填任意一个即可启用（OpenAI 兼容协议）
# 注意：若操作系统已存在同名环境变量（如 DEEPSEEK_API_KEY），其优先级高于本文件，
# 需先修改或删除系统变量（setx DEEPSEEK_API_KEY ""），否则本文件配置不生效。
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# 数字人第三方 API（一期）：auto 按已配置 Key 自动选择；mock 只产脚本与任务单不合成成片
# 双供应商备份：首选提交失败会自动切换另一家
AVATAR_PROVIDER=auto
AVATAR_ZHIYING_BASE_URL=
AVATAR_ZHIYING_API_KEY=
AVATAR_SILICON_BASE_URL=
AVATAR_SILICON_API_KEY=
AVATAR_TIMEOUT=20

# NCBI PubMed E-utilities（配置 api_key 可提升限流到 10 req/s，建议生产填写）
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TIMEOUT=30
