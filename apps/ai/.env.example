# 复制为 .env 并填入真实 Key（.env 已被 gitignore）
ENV=dev

# 大模型路由：auto 按已配置 Key 自动选择；也可显式指定 deepseek/qwen/glm/mock
LLM_PROVIDER=auto
# 覆盖默认模型（留空用服务商默认：deepseek-chat / qwen-plus / glm-4-flash）
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 填任意一个即可启用（OpenAI 兼容协议）
# 注意：若操作系统已存在同名环境变量（如 DEEPSEEK_API_KEY），其优先级高于本文件，
# 需先修改或删除系统变量（setx DEEPSEEK_API_KEY ""），否则本文件配置不生效。
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
